{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "portfolio/flowchart-diagram",
  "version": "1.0.0",
  "title": "Diagram / Architecture (Схема потока)",
  "category": "design",
  "icon": "networking",
  "description": "Контейнер под архитектурные схемы с зумом и поддержкой прозрачных SVG",
  "attributes": {
    "diagramUrl": {
      "type": "string",
      "default": ""
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "tag": {
      "type": "string",
      "default": "system_architecture"
    },
    "bgMode": {
      "type": "string",
      "default": "card"
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": [
    "file:./index.css",
    "file:./style-index.css"
  ]
}